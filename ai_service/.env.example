# AI service env template.
# - For docker-compose deployment, SECRET_KEY/ALGORITHM/QDRANT_URL are usually injected from root `.env`.
# - Keep provider keys and AI-specific options here.

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

SECRET_KEY=your-backend-secret-key
ALGORITHM=HS256

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-turbo-preview

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Qdrant（可选：不填则使用本地持久化目录 data/rag/qdrant）
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks

# RAG Embedding（默认复用 QWEN 配置）
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v3
