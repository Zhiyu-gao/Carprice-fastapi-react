MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_HOST=house_mysql
MYSQL_PORT=3306
MYSQL_DB=house_price_db

# 可选：本地数据库（不填则回退到上面的 MYSQL_*）
LOCAL_MYSQL_USER=
LOCAL_MYSQL_PASSWORD=
LOCAL_MYSQL_HOST=
LOCAL_MYSQL_PORT=
LOCAL_MYSQL_DB=

# 可选：云端数据库（启用云端写入时必填）
CLOUD_MYSQL_USER=
CLOUD_MYSQL_PASSWORD=
CLOUD_MYSQL_HOST=
CLOUD_MYSQL_PORT=
CLOUD_MYSQL_DB=

# SQL 日志开关
SQL_ECHO=false

SECRET_KEY=abc123
ALGORITHM=HS256

DATA_DIR=/Users/zhiyu/Documents/Vehicle-Intelligence-Platform/backend/data

# Redis（邮箱验证码）
REDIS_URL=redis://localhost:6379/0

# 阿里云邮箱（验证码发送）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_MAIL_FROM=

# OSS（对象存储）
OSS_ENABLED=false
OSS_AUTH_MODE=keys
OSS_BUCKET=zhiyu-gao-20260206
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_PREFIX=car-price
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_URL_EXPIRE=600

# 文件在数据库中的返回形式：
# relative | oss_public | oss_signed | auto
FILE_URL_MODE=auto

# 可选：自定义 OSS 对外域名（如 CDN）
OSS_PUBLIC_BASE_URL=
