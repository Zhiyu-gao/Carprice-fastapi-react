# 本地真机/模拟器调试时，127.0.0.1 指向的是设备自身，不是电脑。
# 请改成你电脑的局域网 IP，例如：
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000
# EXPO_PUBLIC_AI_BASE_URL=http://192.168.1.10:8080
#
# 如果走线上域名，请使用：
# EXPO_PUBLIC_API_BASE_URL=https://www.nrydawang.shop/api
# EXPO_PUBLIC_AI_BASE_URL=https://www.nrydawang.shop/ai
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
EXPO_PUBLIC_AI_BASE_URL=http://127.0.0.1:8080
